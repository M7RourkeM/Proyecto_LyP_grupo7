# Copiar este archivo como .env y ajustar los valores.

# Base de datos. Por defecto: backend/mesa_servicios.db
# DATABASE_URL=sqlite:///C:/ruta/a/mesa_servicios.db

# Prolog
# Implementacion del adaptador: subprocess | pyswip
PROLOG_ADAPTADOR=subprocess
# Base de conocimiento (ruta relativa a backend/ o absoluta)
PROLOG_KB=app/prolog/kb/motor_inferencia.pl
# Ejecutable de SWI-Prolog. Si no esta en el PATH, usar la ruta completa:
# SWIPL_EJECUTABLE=C:/Program Files/swipl/bin/swipl.exe
SWIPL_EJECUTABLE=swipl
PROLOG_TIMEOUT_S=10

# IA generativa local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b
OLLAMA_TIMEOUT_S=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURA=0.2
# false: no se llama a la IA y la guia y la nota salen de la plantilla
IA_HABILITADA=true

# Correlacion masiva: ventana en horas para buscar tiquetes abiertos similares
CORRELACION_HORAS=24
# Recurrencia: mismo usuario o activo, misma categoria, N veces en X dias
RECURRENCIA_MINIMO=3
RECURRENCIA_DIAS=30

# Jornada laboral para el SLA en horas habiles (lunes a viernes, hora local)
JORNADA_INICIO_HORA=8
JORNADA_FIN_HORA=16
ZONA_HORARIA_UTC_OFFSET=-6

# Tiempo maximo por dependencia en GET /salud
SALUD_TIMEOUT_S=3
